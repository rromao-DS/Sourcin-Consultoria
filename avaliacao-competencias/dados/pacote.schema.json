      "properties": {
        "avaliacao_id": {
          "type": "string",
          "format": "uuid"
        },
        "indicador_id": {
          "type": "string",
          "format": "uuid"
        },
        "valor": {
          "type": [
            "number",
            "null"
          ]
        },
        "observacao": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "avaliacao_id",
        "indicador_id"
      ],
      "additionalProperties": false
    },
    "registro_assiduidade": {
      "description": "Contagens do mês. Sem atestado, CID ou motivo de saúde.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "empresa_id": {
          "type": "string",
          "format": "uuid"
        },
        "pessoa_id": {
          "type": "string",
          "format": "uuid"
        },
        "mes": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-01$"
        },
        "faltas_injustificadas": {
          "type": "integer",
          "minimum": 0
