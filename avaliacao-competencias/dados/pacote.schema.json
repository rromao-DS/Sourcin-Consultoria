        "id": {
          "type": "string",
          "format": "uuid"
        },
        "empresa_id": {
          "type": "string",
          "format": "uuid"
        },
        "ciclo_id": {
          "type": "string",
          "format": "uuid"
        },
        "pessoa_id": {
