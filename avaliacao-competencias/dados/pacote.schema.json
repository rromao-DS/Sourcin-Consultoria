        "indicador_id"
      ],
      "additionalProperties": false
    },
    "politica_avaliacao": {
      "description": "Regras de cálculo. empresa_id nulo = padrão R2 Tech.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "empresa_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "nome": {
          "type": "string",
          "minLength": 1
        },
        "peso_comportamental": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "peso_tecnico": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "peso_indicadores": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "conversao_faltas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "a_partir_de": {
                "type": "number"
              },
              "nota": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              }
            },
            "required": [
              "a_partir_de",
              "nota"
            ],
            "additionalProperties": false
          }
        },
        "conversao_atrasos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "a_partir_de": {
                "type": "number"
              },
              "nota": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              }
            },
            "required": [
              "a_partir_de",
              "nota"
            ],
            "additionalProperties": false
          }
        },
        "conversao_percentual": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "a_partir_de": {
                "type": "number"
              },
              "nota": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              }
            },
            "required": [
              "a_partir_de",
              "nota"
            ],
            "additionalProperties": false
          }
        },
        "faixas_gratificacao": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "a_partir_de": {
                "type": "number"
              },
              "percentual": {
                "type": "number",
                "minimum": 0
              },
              "faixa": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "a_partir_de",
              "percentual",
              "faixa"
            ],
            "additionalProperties": false
          }
        },
        "periodicidade": {
          "enum": [
            "semestral",
            "anual",
            "trimestral"
          ]
        },
        "atestado_reduz_nota": {
          "type": "boolean"
        },
        "validada_em": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      },
      "required": [
        "id",
        "nome",
        "peso_comportamental",
        "peso_tecnico",
        "peso_indicadores",
        "conversao_faltas",
        "conversao_atrasos",
        "conversao_percentual",
        "faixas_gratificacao"
      ],
      "additionalProperties": false
    },
