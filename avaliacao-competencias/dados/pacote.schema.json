            "null"
          ]
        },
        "nota_comportamental": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "nota_tecnica": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "nota_indicadores": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "nota_final": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        }
